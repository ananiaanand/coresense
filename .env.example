# Coresense Live Pitch Real-Time Sync Configuration
#
# Create a free Supabase project at https://supabase.com
# Copy your Project URL and anon public key from Project Settings > API
#
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-key-here

# Note: Coresense has a built-in cross-window/cross-tab BroadcastChannel & LocalStorage fallback
# as well as a cloud sync fallback so you can demo immediately even before pasting Supabase keys!
